*.pdb

# Visual Studio 2015 user specific files
# visual studio settings are exported as a file in the root directory - NauPhy
i_love_vampires_2/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# This was only for reference - NauPhy
MyProject/*

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
# Appear not to be present, leaving unchanged -NauPhy
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
i_love_vampires_2/Binaries/*
i_love_vampires_2/Plugins/**/Binaries/*

# Builds
i_love_vampires_2/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!i_love_vampires_2/Build/*/
i_love_vampires_2/Build/*/**
!i_love_vampires_2/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!i_love_vampires_2/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
i_love_vampires_2/Saved/*

# Compiled source files for the engine to use
# Note that this is the default directory for manually generated source files. They don't compile if you put them there anyway, but this rule means they won't be committed either -NauPhy
i_love_vampires_2/Intermediate/*
i_love_vampires_2/Plugins/**/Intermediate/*
# My filters! - NauPhy
!i_love_vampires_2/Intermediate/ProjectFiles
i_love_vampires_2/Intermediate/ProjectFiles/*
!i_love_vampires_2/Intermediate/ProjectFiles/i_love_vampires_2.vcxproj.user
!i_love_vampires_2/Intermediate/ProjectFiles/i_love_vampires_2.vcxproj.filters

# Cache files for the editor to use
i_love_vampires_2/DerivedDataCache/*
